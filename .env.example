# Demonstration settings for local development. Replace for any shared deployment.
# Changing credentials does not change users/passwords in existing database volumes.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=linkpulse
CLICKHOUSE_DATABASE=linkpulse
CLICKHOUSE_USER=linkpulse
CLICKHOUSE_PASSWORD=linkpulse
HTTP_BIND_PORT=8080

# For services started directly with go run (Compose sets these itself):
HTTP_PORT=8080
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/linkpulse?sslmode=disable
ANALYTICS_GRPC_ADDR=localhost:9090
GRPC_PORT=9090
CLICKHOUSE_ADDR=localhost:9000

# Only the isolated integration Compose publishes this additional HTTP port.
TEST_HTTP_PORT=18080
